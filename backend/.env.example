# Copy to .env. Use a dedicated MySQL database and a least-privilege account.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=enter-your-local-mysql-password
DB_NAME=trialguard
# Daily reminders at 09:00 in this timezone. Dates use this timezone consistently.
APP_TIMEZONE=Asia/Kolkata
REMINDER_CRON=0 9 * * *
# Optional. Leave blank to use in-app delivery only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional backend-only OpenAI integration. No key => unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
