{
  "name": "trialguard",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "reminders": "npm run reminders --prefix backend",
    "test": "npm test --prefix backend",
    "test:integration": "npm run test:integration --prefix backend",
    "setup": "npm install --prefix backend && npm install --prefix frontend",
    "test:browser": "node scripts/browser-tests.cjs",
    "format": "prettier --write \"backend/**/*.js\" \"frontend/src/*.{js,jsx,css}\" \"frontend/vite.config.js\" \"tests/*.js\" playwright.config.js",
    "test:production": "npm run test:production --prefix backend"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10"
  }
}
